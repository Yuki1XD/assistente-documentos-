# Banco local padrão (SQLite). Para PostgreSQL, use:
# DATABASE_URL=postgresql+psycopg://usuario:senha@localhost:5432/assistente_docs
DATABASE_URL=sqlite:///./data/assistente.db

# Limite de upload em MB
MAX_UPLOAD_MB=15

# Integração opcional com API compatível com OpenAI.
# Groq (recomendado neste projeto):
# AI_API_BASE=https://api.groq.com/openai/v1
# AI_MODEL=openai/gpt-oss-20b
# OpenAI:
# AI_API_BASE=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini
# Gemini:
# AI_API_BASE=https://generativelanguage.googleapis.com/v1beta/openai/
# AI_MODEL=gemini-2.5-flash
# Sem aspas e sem espaços em volta do "=".
AI_API_BASE=https://api.groq.com/openai/v1
AI_API_KEY=
AI_MODEL=openai/gpt-oss-20b
AI_TIMEOUT_SECONDS=60
