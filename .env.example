# Banco local padrão (SQLite). Para PostgreSQL, use:
# DATABASE_URL=postgresql+psycopg://usuario:senha@localhost:5432/assistente_docs
DATABASE_URL=sqlite:///./data/assistente.db

# Limite de upload em MB
MAX_UPLOAD_MB=15

# Integração opcional com API compatível com OpenAI
# Exemplo de endpoint base: https://api.openai.com/v1
AI_API_BASE=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_SECONDS=60
